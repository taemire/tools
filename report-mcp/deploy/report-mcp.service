[Unit]
Description=ARTEX report PDF MCP service (loopback only)
After=network-online.target report-mcp-firewall.service
Requires=report-mcp-firewall.service

[Service]
Type=simple
User=artex-runtime
Group=artex-runtime
WorkingDirectory=/opt/artex-lab/report-mcp
Environment=HOME=/opt/artex-lab/report-mcp/cache
Environment=XDG_CACHE_HOME=/opt/artex-lab/report-mcp/cache
Environment=REPORT_SESSION_ROOT=/opt/artex-lab/data/sessions
Environment=REPORT_OUTPUT_ROOT=/opt/artex-lab/data/report-pdf
Environment=REPORT_PUBLIC_ROOT=/app/data/report-pdf
Environment=MD2PDF_BIN=/opt/artex-lab/report-mcp/bin/md2pdf
Environment=REPORT_LISTEN=127.0.0.1:8891
# Resident Chrome DevTools endpoint (IPv4 loopback only). The legacy md2pdf path reuses it and
# falls back to its own Chrome on 127.0.0.1:9223 only when it does not answer.
Environment=REPORT_CHROME_URL=http://127.0.0.1:9223
Environment=REPORT_MD2PDF_DEVTOOLS_PORT=9223
# Noto Sans JP/SC Bold TTF for Japanese/Chinese watermarks (arx-pentest-report-1); optional.
Environment=REPORT_PR_FONT_DIR=/opt/artex-lab/report-mcp/fonts
# Pinned figure faces for render_report_figures: the same files and hashes as the app font dir (ARTEX_REPORT_VISUAL_FONT_DIR). Required.
Environment=REPORT_FIGURE_FONT_REGULAR=/opt/artex-lab/data/fonts/Pretendard-Regular.otf
Environment=REPORT_FIGURE_FONT_MONO=/opt/artex-lab/data/fonts/D2Coding.ttf
Environment=REPORT_FIGURE_FONT_MEDIUM=/opt/artex-lab/data/fonts/Pretendard-Medium.otf
Environment=REPORT_FIGURE_FONT_BOLD=/opt/artex-lab/data/fonts/Pretendard-Bold.otf
ExecStart=/opt/artex-lab/report-mcp/bin/report-mcp
Restart=on-failure
RestartSec=3
UMask=0027
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
ReadOnlyPaths=/opt/artex-lab/data/sessions
ReadWritePaths=/opt/artex-lab/data/report-pdf /opt/artex-lab/report-mcp/cache
IPAddressDeny=any
IPAddressAllow=localhost
MemoryMax=1536M
CPUQuota=150%
TasksMax=256

[Install]
WantedBy=multi-user.target
